// Схема для модели "Сезон" в базе данных, используемая с Prisma ORM
model Season {
	id String @id @default(cuid()) // Уникальный идентификатор сезона, генерируемый автоматически

	number Int // Номер сезона

	series Series @relation(fields: [seriesId], references: [id]) // Связь с моделью "Серия", указывающая, что каждый сезон принадлежит одной серии
	seriesId String @map("series_id") // Внешний ключ для связи с моделью "Серия", отображаемый в базе данных как "series_id"

	episodes Episode[] // Связь с моделью "Эпизод", указывающая, что один сезон может содержать несколько эпизодов

	createdAt DateTime @default(now()) @map("created_at") // Дата и время создания записи, по умолчанию устанавливается на текущее время, отображаемое в базе данных как "created_at"
	updatedAt DateTime @updatedAt @map("updated_at") // Дата и время последнего обновления записи, автоматически обновляемое при каждом изменении, отображаемое в базе данных как "updated_at"

	@@map("seasons") // Указывает, что данная модель будет отображаться в базе данных в виде таблицы "seasons"
}