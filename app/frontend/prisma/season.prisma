model Season {
	id String @id @default(cuid())

	number Int

	series Series @relation(fields: [seriesId], references: [id])
	seriesId String @map("series_id")

	episodes Episode[]

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@map("seasons")
}