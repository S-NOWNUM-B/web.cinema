model Series {
	id String @id @default(cuid())

	title String
	slug String @unique

	description String
	year Int?
	rating String?

	imageUrl String @map("image_url")
	posterUrl String @map("poster_url")

	genres Genre[]
	seasons Season[]

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@map("series")
}