// Схема Prisma для генерации клиента и подключения к базе данных PostgreSQL
model Genre {
	id String @id @default(cuid()) // Уникальный идентификатор жанра, генерируемый с помощью функции cuid()

	name String // Название жанра
	slug String @unique // Уникальный слаг для жанра, используемый в URL
	
	series Series[] // Связь с моделью Series, указывающая, что жанр может быть связан с несколькими сериалами

	createdAt DateTime @default(now()) @map("created_at") // Дата и время создания жанра, с указанием имени поля в базе данных
	updatedAt DateTime @updatedAt @map("updated_at") // Дата и время последнего обновления жанра, с указанием имени поля в базе данных

	@@map("genres") // Указывает имя таблицы в базе данных для модели Genre
}